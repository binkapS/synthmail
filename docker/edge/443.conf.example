# SynthMail edge HTTPS server — activated by the compose command only when
# /etc/letsencrypt/live/mail.example.com exists (ACME or copy-in certs).
server {
    listen 443 ssl;
    server_name _;
    ssl_certificate /etc/letsencrypt/live/mail.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mail.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    location /api/ { proxy_pass http://synth-control:8000; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; }
    location /mail/ { proxy_pass http://synth-webmail:3000; proxy_set_header Host $host; }
    location /jmap { proxy_pass http://synth-webmail:3000; }
    location /jmap/ { proxy_pass http://synth-webmail:3000; }
    location /dav/ { proxy_pass http://synth-webmail:3000; }
    location /.well-known/carddav { proxy_pass http://synth-webmail:3000; }
    location /.well-known/caldav { proxy_pass http://synth-webmail:3000; }
    location / { proxy_pass http://synth-webmail:3000; proxy_set_header Host $host; }
}
