# SynthMail fail2ban jails (Debian fail2ban 1.0.2).
# banaction = dummy: per-container networking means fail2ban cannot reach
# the mail containers' netns, so IP enforcement happens upstream (edge +
# in-app rate limiting); fail2ban here parses auth logs and feeds bans
# into the DB + watchdog alerting.
[DEFAULT]
bantime = 3600
findtime = 600
maxretry = 5
banaction = dummy
usedns = warn
allowipv6 = auto

# Package default jail (jail.d/defaults-debian.conf) - no sshd here.
[sshd]
enabled = false

# Debian 1.0.2 has no standalone postfix-sasl filter; postfix.conf has a
# mode selector: auth = SASL failures.
[postfix-sasl]
enabled = true
port = smtp,submission,smtps
filter = postfix[mode=auth]
logpath = /var/log/postfix.log
backend = polling

[dovecot]
enabled = true
port = imap,pop3,sieve
filter = dovecot
logpath = /var/log/dovecot.log
backend = polling

# NOTE: no synth-webmail jail - webmail rate limiting/banning is enforced
# in-app (synth-common rate_limit + login_attempts table), and webmail logs
# to stdout, so there is no log file for fail2ban to tail.
