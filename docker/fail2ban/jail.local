[DEFAULT]
bantime = 3600
findtime = 600
maxretry = 5

[postfix-sasl]
enabled = true
port = smtp,submission,smtps
filter = postfix-sasl
logpath = /var/log/postfix.log
backend = polling
maxretry = 5
bantime = 3600

[dovecot]
enabled = true
port = imap,pop3,sieve
filter = dovecot
logpath = /var/log/dovecot.log
backend = polling
maxretry = 5

[synth-webmail]
enabled = true
port = http,https
filter = synth-webmail
logpath = /var/log/synth-webmail.log
backend = polling
maxretry = 5
bantime = 3600
