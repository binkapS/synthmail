# SynthMail — copy to .env, fill, chmod 600 .env
# Required secrets: no safe defaults. docker compose will fail fast if these
# are unset or left as placeholders (see compose.yaml).
MAIL_HOST=mail.example.com
MAIL_DOMAIN=example.com
TIMEZONE=Etc/UTC

# TLS / ACME (audit C-06): provision certs before starting the stack.
#   docker compose --profile acme run --rm acme   # staging cert
#   # remove --staging in the acme entrypoint for production
# Then Dovecot/Postfix/edge find them under certs/live/<MAIL_HOST>/.
LETSENCRYPT_EMAIL=admin@example.com

# DB
POSTGRES_USER=synth
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM
POSTGRES_DB=synthmail
DATABASE_URL=postgres://synth:CHANGE_ME_STRONG_RANDOM@postgres:5432/synthmail

# Redis — the redis service enforces --requirepass (audit H-08), so the
# password here and in REDIS_URL must match.
REDIS_PASSWORD=CHANGE_ME_REDIS
REDIS_URL=redis://:CHANGE_ME_REDIS@redis:6379

# App
SESSION_SECRET=CHANGE_ME_32B_MIN_0123456789ABCDEF_0123456789
# AES-256 key (64 hex chars) for DKIM private keys + TOTP secrets at rest
# (audit M-15/H-07). Generate: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_0123456789ABCDEF0123456789ABCDEF0123456789
CONTROL_URL=https://mail.example.com/api
WEBMAIL_URL=https://mail.example.com/mail
ADMIN_URL=https://mail.example.com/admin
INITIAL_ADMIN_EMAIL=admin@example.com
# Leave empty to have a random one-time password generated (written to
# /run/secrets/initial-admin-password). Any value set here must pass the
# password policy (>=12 chars, not a known default).
INITIAL_ADMIN_PASSWORD=

# Monitoring
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_STRONG

# Auth / Spam
MAX_QUOTA_MB=5120
SPAM_THRESHOLD=7
# Phase 2: rate limiting & 2FA
RATE_LIMIT_PER_MIN=30
HIBP_ENABLED=true
TOTP_ENFORCED_FOR_ADMIN=true

# Monitoring / alerts
ALERT_WEBHOOK_URL=
NTFY_TOPIC=
POSTFIX_QSHAPE_PATH=/var/spool/postfix/deferred

# CardDAV / CalDAV (Radicale behind synth-webmail /dav)
RADICALE_URL=http://radicale:5232

# Backup
BACKUP_RETENTION_DAYS=14
RCLONE_REMOTE=
