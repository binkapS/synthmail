# SynthMail — copy to .env, fill, chmod 600 .env
# Required secrets: no safe defaults. docker compose will fail fast if these
# are unset or left as placeholders (see compose.yaml).
MAIL_HOST=mail.example.com
MAIL_DOMAIN=example.com
TIMEZONE=Etc/UTC

# TLS / ACME (audit C-06): provision certs before starting the stack.
#   docker compose --profile acme run --rm acme
# ACME_STAGE selects the certbot environment:
#   staging  -> certbot --staging (tests the renewal pipeline, safe)
#   prod     -> production Let's Encrypt certificate (default)
# Test with ACME_STAGE=staging first; switch to prod for cutover.
# Then Dovecot/Postfix/edge find them under certs/live/<MAIL_HOST>/.
LETSENCRYPT_EMAIL=admin@example.com
ACME_STAGE=prod

# DB
POSTGRES_USER=synth
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM
POSTGRES_DB=synthmail
DATABASE_URL=postgres://synth:CHANGE_ME_STRONG_RANDOM@postgres:5432/synthmail

# Redis — the redis service enforces --requirepass (audit H-08), so the
# password here and in REDIS_URL must match.
REDIS_PASSWORD=CHANGE_ME_REDIS
REDIS_URL=redis://:CHANGE_ME_REDIS@redis:6379

# App
SESSION_SECRET=CHANGE_ME_32B_MIN_0123456789ABCDEF_0123456789
# CORS allow-list for the webmail/JMAP API (audit S-01). Empty = legacy
# wildcard CORS (the pre-S-01 default). Set to a CSV of origins the UI
# actually loads from, e.g. CORS_ORIGINS=https://mail.example.com
# The admin UI ships same-origin behind the nginx edge, so leave this empty
# unless you serve the UI from a different origin.
CORS_ORIGINS=
# AES-256 key (64 hex chars) for DKIM private keys + TOTP secrets at rest
# (audit M-15/H-07). Generate: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_0123456789ABCDEF0123456789ABCDEF0123456789
CONTROL_URL=https://mail.example.com/api
WEBMAIL_URL=https://mail.example.com/mail
ADMIN_URL=https://mail.example.com/admin
INITIAL_ADMIN_EMAIL=admin@example.com
# Leave empty to have a random one-time password generated (written to
# /run/secrets/initial-admin-password). Any value set here must pass the
# password policy (>=12 chars, not a known default).
INITIAL_ADMIN_PASSWORD=

# Monitoring
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_STRONG

# Auth / Spam
MAX_QUOTA_MB=5120
SPAM_THRESHOLD=7
# Phase 2: rate limiting & 2FA
RATE_LIMIT_PER_MIN=30
HIBP_ENABLED=true
TOTP_ENFORCED_FOR_ADMIN=true

# Monitoring / alerts
ALERT_WEBHOOK_URL=
# NTFY_TOPIC must be a strong, unguessable token. Public ntfy.sh streams
# are readable by anyone who knows the topic; use a private ntfy for
# production mail hosts (audit S-03).
NTFY_TOPIC=
# Optional: override the public ntfy.sh base URL with your self-hosted
# or private ntfy.
NTFY_BASE_URL=
POSTFIX_QSHAPE_PATH=/var/spool/postfix/deferred

# CardDAV / CalDAV (Radicale behind synth-webmail /dav)
RADICALE_URL=http://radicale:5232

# Plan §1: mail-edge network mode.
#   host     (default) — postfix/dovecot/rspamd/clamav bind host ports; the
#            public remote IP reaches Postfix/Rspamd/RBL checks.
#   (empty)  — bridge-NAT fallback: attach to the `mailnet` bridge and restore
#            the published 25/465/587 / 993/4190 ports. Only use when you do
#            NOT need the public source IP in Postfix logs.
MAIL_EDGE_NETWORK=host
# Plan §1: "1" tells the Postfix/Dovecot entrypoints the stack is on the host
# network so they tighten internal peer trust (loopback-only mynetworks).
MAIL_EDGE=1

# Plan §3: admin container-stats view is opt-in. Default is OFF so the
# Docker socket mount is not required. Set ENABLE_CONTAINER_STATS=1 and
# uncomment the /var/run/docker.sock volume mount in compose.yaml (synth-
# control service) to show per-container status in the admin Server panel.
# DOCKER_SOCKET overrides the socket path if not the default.
ENABLE_CONTAINER_STATS=0
DOCKER_SOCKET=/var/run/docker.sock

# Backup
BACKUP_RETENTION_DAYS=14
RCLONE_REMOTE=


# Edge / reverse proxy (mailcow-style, audit H-05)
# Host ports the edge container publishes. Set HTTP_PORT=80 / HTTPS_PORT=443
# to bind directly, or keep the defaults and front SynthMail with your own
# reverse proxy on 80/443. HTTP_BIND/HTTPS_BIND restrict the bind address.
HTTP_BIND=0.0.0.0
HTTP_PORT=8080
HTTPS_BIND=0.0.0.0
HTTPS_PORT=8443
