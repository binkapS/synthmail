// FiltersPanel — Sieve filters list + save.
import { Card } from "../components/card.slint";
import { Badge } from "../components/badge.slint";
import { Button } from "../components/button.slint";
import { TextField } from "../components/text-field.slint";
import { EmptyState } from "../components/empty-state.slint";
import { ErrorBanner } from "../components/error-banner.slint";
import { FilterRow } from "../models.slint";

export component FiltersPanel {
    in-out property <[FilterRow]> rows;
    in-out property <bool> loading;
    in-out property <string> error;
    in-out property <string> json;

    callback on_refresh();
    callback on_save(json: string);

    VerticalLayout {
        width: 100%;
        spacing: 10px;

        Card {
            VerticalLayout {
                Text { text: "Filters (Sieve)"; color: #F2F5FF; font-size: 18px; font-weight: 700; }
                if root.error != "": ErrorBanner { message: root.error; }
                Button { text: "Save filters"; clicked => { on_save(root.json); } }
            }
        }

        Card {
            VerticalLayout {
                spacing: 0px;
                if rows.length == 0:
                    EmptyState { text: "No filters."; }
                for row in rows:
                    HorizontalLayout {
                        width: 100%;
                        height: 56px;
                        spacing: 8px;
                        padding: 8px;
                        Text { text: row.name; color: #F2F5FF; font-size: 14px; font-weight: 500; width: 100%; }
                        Text { text: row.action; color: #93A0C8; font-size: 12px; width: 30%; }
                        Badge { text: "pri " + row.priority; color: #2D3D64; text-color: #93A0C8; }
                    }
                }
            }
        }
    }

