// QueuesPanel — mail queues depth.
import { Card } from "../components/card.slint";
import { Badge } from "../components/badge.slint";
import { EmptyState } from "../components/empty-state.slint";
import { QueueRow } from "../models.slint";

export component QueuesPanel {
    in-out property <[QueueRow]> rows;
    in-out property <bool> loading;
    in-out property <string> error;

    callback on_refresh();

    VerticalLayout {
        width: 100%;
        spacing: 10px;

        Card {
            VerticalLayout {
                Text { text: "Queues"; color: #F2F5FF; font-size: 18px; font-weight: 700; }
            }
        }

        Card {
            VerticalLayout {
                spacing: 0px;
                if rows.row_count() == 0:
                    EmptyState { text: "No queues."; }
                for row in rows:
                    HorizontalLayout {
                        width: 100%;
                        height: 56px;
                        spacing: 8px;
                        padding: 8px;
                        Text { text: row.name; color: #F2F5FF; font-size: 14px; font-weight: 500; width: 100%; }
                        Badge { text: row.depth + " deferred"; }
                    }
                }
            }
        }
    }

