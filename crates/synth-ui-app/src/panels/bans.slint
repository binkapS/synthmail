// BansPanel — banned IPs + lift.
import { Card } from "../components/card.slint";
import { Badge } from "../components/badge.slint";
import { EmptyState } from "../components/empty-state.slint";
import { BanRow } from "../models.slint";

export component BansPanel {
    in-out property <[BanRow]> rows;
    in-out property <bool> loading;
    in-out property <string> error;

    callback on_refresh();
    callback on_lift(ip: string);

    VerticalLayout {
        width: 100%;
        spacing: 10px;

        Card {
            VerticalLayout {
                Text { text: "Bans"; color: #F2F5FF; font-size: 18px; font-weight: 700; }
            }
        }

        Card {
            VerticalLayout {
                spacing: 0px;
                if rows.length == 0:
                    EmptyState { text: "No active bans."; }
                for row in rows:
                    HorizontalLayout {
                        width: 100%;
                        height: 56px;
                        spacing: 8px;
                        padding: 8px;
                        Text { text: row.ip; color: #F2F5FF; font-size: 14px; font-weight: 500; width: 100%; }
                        Text { text: row.reason; color: #93A0C8; font-size: 12px; width: 60%; }
                        Text { text: row.until; color: #93A0C8; font-size: 12px; width: 20%; }
                        TouchArea { width: 72px; height: 32px; clicked => on_lift(row.ip); Text { text: "Lift"; color: #34D399; font-size: 12px; } }
                    }
                }
            }
        }
    }

