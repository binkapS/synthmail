// ConfigPanel — export/import config.
import { Card } from "../components/card.slint";
import { TextField } from "../components/text-field.slint";
import { ErrorBanner } from "../components/error-banner.slint";
import { EmptyState } from "../components/empty-state.slint";

export component ConfigPanel {
    in-out property <string> export_result;
    in-out property <string> export_result_open;
    in-out property <string> error;
    in-out property <string> import_path;

    callback on_export();
    callback on_import(path: string);
    callback on_export_result_close();

    VerticalLayout {
        width: 100%;
        height: auto;
        spacing: 10px;

        Card {
            VerticalLayout {
                Text { text: "Configuration"; color: #F2F5FF; font-size: 18px; font-weight: 700; }
                TextField { label: "Import JSON file"; placeholder: "/path/config.json"; text: root.import_path; }
                if root.error != "": ErrorBanner { message: root.error; }
                Button { text: "Export";
                         clicked => { on_export(); } }
                Button { text: "Import",
                         clicked => { if root.import_path != "" { on_import(root.import_path); } } }
            }
        }

        if root.export_result_open != "":
            Card {
                Text { text: root.export_result; color: #93A0C8; font-size: 12px; }
                TouchArea { width: 100%; height: 32px; clicked => on_export_result_close(); Text { text: "Close", color: #F2F5FF; font-size: 12px; } }
            }
    }
}
