// OverviewPanel — admin overview: stats cards + recent audit activity.
import { Card } from "../components/card.slint";
import { StatRow, AuditRow } from "../models.slint";
import { StatCard } from "../components/stat-card.slint";
import { EmptyState } from "../components/empty-state.slint";

export component OverviewPanel {
    in-out property <[StatRow]> stats;
    in-out property <[AuditRow]> audit;

    VerticalLayout {
        width: 100%;
        spacing: 10px;

        Card {
            VerticalLayout {
                spacing: 10px;
                Text { text: "Overview"; color: #F2F5FF; font-size: 18px; font-weight: 700; }
                HorizontalLayout {
                    spacing: 10px;
                    for row in stats: StatCard { stat: row; }
                }
            }
        }

        Card {
            VerticalLayout {
                spacing: 0px;
                Text { text: "Recent activity"; color: #F2F5FF; font-size: 18px; font-weight: 700; }
                if audit.length == 0: EmptyState { text: "No audit entries."; }
                for row in audit:
                    HorizontalLayout {
                        width: 100%;
                        height: 56px;
                        spacing: 8px;
                        padding: 8px;
                        Text { text: row.actor; color: #F2F5FF; font-size: 13px; font-weight: 500; width: 100%; }
                        Text { text: row.action; color: #93A0C8; font-size: 12px; width: 100%; }
                        Text { text: row.time; color: #93A0C8; font-size: 12px; width: 20%; }
                    }
            }
        }
    }
}
