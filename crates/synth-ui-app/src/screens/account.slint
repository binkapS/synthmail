export component AccountScreen {
    callback on_logout();

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 16px;

        TopBar {
            title: "Account";
            on_logout => root.on_logout();
        }

        Text {
            text: "Account panel — Phase 6";
            color: #5C6CA0;
        }
    }
}
