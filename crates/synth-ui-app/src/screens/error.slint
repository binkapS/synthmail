// ErrorScreen — offline/connection failure with retry.
import { Card } from "../components/card.slint";

export component ErrorScreen {
    in-out property <string> message: "Connection failed";

    callback retry();

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;

        Card {
            width: 440px;
            height: 200px;

            VerticalLayout {
                width: 100%;
                height: 100%;
                alignment: center;
                spacing: 16px;

                Text {
                    text: root.message;
                    color: #F87171;
                    font-size: 14px;
                }
                TouchArea {
                    width: 160px;
                    height: 44px;
                    clicked => { root.retry(); }
                }
            }
        }
    }
}
