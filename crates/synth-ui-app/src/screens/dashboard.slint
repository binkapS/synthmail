// DashboardScreen — admin/user landing (parity: old /). Rust fills stats +
// activity list once wired (Phase 5).
import { Card } from "../components/card.slint";
import { TopBar } from "../components/top-bar.slint";

export component DashboardScreen {
    callback on_go_admin();
    callback on_go_mail();
    callback on_refresh();

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 16px;

        TopBar {
            title: "Dashboard";
            on_refresh => {};
        }

        VerticalLayout {
            width: 480px;
            height: 100%;
            alignment: center;
            spacing: 8px;

            Card {
                Text {
                    text: "Welcome back";
                    color: #F2F5FF;
                    font-size: 28px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                TouchArea {
                    width: 100%;
                    height: 44px;
                    clicked => { root.on_go_admin(); }
                }
                TouchArea {
                    width: 100%;
                    height: 44px;
                    clicked => { root.on_go_mail(); }
                }
            }
        }
    }
}
