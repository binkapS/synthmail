// TextArea — multiline text input (used by compose/reply).
export component TextArea {
    in-out property <string> text: "";
    in-out property <string> placeholder: "";
    in-out property <int> rows: 4;

    VerticalLayout {
        width: 100%;
        height: 200px;

        Rectangle {
            width: 100%;
            border-radius: 8px;
            background: #0A1020;
            border-width: 1px;
            border-color: #2D3D64;

            Text {
                text: root.text;
                color: #F2F5FF;
                font-size: 13px;
            }
        }
    }
}
