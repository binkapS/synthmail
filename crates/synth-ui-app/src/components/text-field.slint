// TextField — text input with label, placeholder, validation state.
export component TextField {
    in-out property <string> text: "";
    in-out property <string> placeholder: "";
    in-out property <string> label: "";
    in-out property <bool> disabled;
    in-out property <string> error-message: "";
    in-out property <bool> read-only;

    VerticalLayout {
        spacing: 4px;
        width: 100%;

        Text {
            text: root.label;
            color: #5C6CA0;
            font-size: 12px;
            font-weight: 500;
        }

        Rectangle {
            width: 100%;
            height: 38px;
            border-radius: 8px;
            background: #0A1020;
            border-width: 1px;
            border-color: #2D3D64;

            HorizontalLayout {
                padding: 12px;
                width: 100%;
                height: 100%;

                Text {
                    text: root.text;
                    color: #F2F5FF;
                    font-size: 13px;
                }
            }
        }

        if root.error-message != "": Text {
            text: root.error-message;
            color: #F87171;
            font-size: 12px;
        }
    }
}
